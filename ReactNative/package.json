{
  "name": "@zerosettle/react-native",
  "version": "1.0.0",
  "description": "React Native bindings for ZeroSettle iOS SDK - web billing migration components",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "ios",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "zerosettle-react-native.podspec"
  ],
  "scripts": {
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build",
    "clean": "del-cli lib"
  },
  "keywords": [
    "react-native",
    "ios",
    "zerosettle",
    "billing",
    "checkout",
    "in-app-purchase",
    "swiftui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerosettle/ZeroSettleKit.git"
  },
  "author": "ZeroSettle <support@zerosettle.io> (https://zerosettle.io)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zerosettle/ZeroSettleKit/issues"
  },
  "homepage": "https://github.com/zerosettle/ZeroSettleKit#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "del-cli": "^5.0.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-builder-bob": "^0.23.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.70.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
